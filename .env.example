# Modèle de configuration — aucune valeur secrète réelle.
# Le programme lit les variables d'environnement ; il ne charge pas ce fichier
# automatiquement. Ne mettez jamais la phrase secrète du chat dans ce fichier.

PORT=8000
CIPHERCHAT_ENV=development
CIPHERCHAT_MAX_CONNECTIONS=100

# Exemple fictif de 16 octets ("0123456789abcdef") pour le développement.
# En production, définissez explicitement une valeur stable différente.
CIPHERCHAT_SALT_B64=MDEyMzQ1Njc4OWFiY2RlZg==
